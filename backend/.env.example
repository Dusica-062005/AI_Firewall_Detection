# Copy to backend/.env and adjust. Never commit a real .env file.

# General
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins (Angular dev server).
CORS_ORIGINS=http://localhost:4200

# Persistence (SQLite file is created automatically)
DATABASE_URL=sqlite:///./data/firewall.db
AUDIT_RETENTION_DAYS=30

# Request limits
MAX_TRANSCRIPT_CHARS=10000
MAX_REQUEST_BYTES=65536

# Detection
SPACY_MODEL=en_core_web_md
DETECTION_SCORE_THRESHOLD=0.35
DETECTION_LOW_CONFIDENCE_THRESHOLD=0.6
# Return detected values to the Inspector UI (synthetic demo only). Never stored in audit.
EXPOSE_DETECTED_VALUES=true
# Action applied to detected entities that no enabled policy covers: LOCAL_ONLY or BLOCK.
UNMATCHED_ENTITY_ACTION=LOCAL_ONLY

# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=45

# Mock CloudLink receiver (simulated integration, runs as a separate process)
CLOUDLINK_BASE_URL=http://localhost:8100
CLOUDLINK_TIMEOUT_SECONDS=5
# Shared secret between the firewall and the mock receiver. Placeholder only.
CLOUDLINK_API_KEY=replace-with-a-local-demo-secret

# Optional: when set, policy mutation endpoints require the X-Admin-Key header.
ADMIN_API_KEY=
