# Copy to backend/.env and adjust. Never commit a real .env file.

# General
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins (Angular dev server).
CORS_ORIGINS=http://localhost:4200

# Persistence (SQLite file is created automatically)
DATABASE_URL=sqlite:///./data/firewall.db
AUDIT_RETENTION_DAYS=30

# Request limits
MAX_TRANSCRIPT_CHARS=10000
MAX_REQUEST_BYTES=65536

# Detection
SPACY_MODEL=en_core_web_md
DETECTION_SCORE_THRESHOLD=0.35
DETECTION_LOW_CONFIDENCE_THRESHOLD=0.6
# Return detected values to the Inspector UI (synthetic demo only). Never stored in audit.
EXPOSE_DETECTED_VALUES=true
# Action applied to detected entities that no enabled policy covers: LOCAL_ONLY or BLOCK.
UNMATCHED_ENTITY_ACTION=LOCAL_ONLY
# Detect spoken and split identifiers ("P four eight two", "nau aath saat", "P48. ... 2913").
NORMALIZE_NUMBERS=true

# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=45

# Mock CloudLink receiver (simulated integration, runs as a separate process)
CLOUDLINK_BASE_URL=http://localhost:8100
CLOUDLINK_TIMEOUT_SECONDS=5
# Shared secret between the firewall and the mock receiver. Placeholder only.
CLOUDLINK_API_KEY=replace-with-a-local-demo-secret

# "Cloud" stand-in: the mock receiver summarizes the TOKENIZED transcript with a larger local
# model (for example llama3.1:8b; run "ollama pull llama3.1:8b" first). Leave empty to disable.
# When enabled, raise CLOUDLINK_TIMEOUT_SECONDS (for example to 120) so the firewall waits for it.
MOCK_CLOUD_MODEL=
MOCK_CLOUD_TIMEOUT_SECONDS=120
# Every payload the mock receiver accepts is appended here; leak canaries measure against it.
RECEIVED_LOG_FILE=./data/received.log

# Dial quality score: embedding model (run "ollama pull nomic-embed-text" first) and the model
# that summarizes the RAW synthetic samples as the reference. Empty reference -> MOCK_CLOUD_MODEL
# if set, else OLLAMA_MODEL.
QUALITY_EMBED_MODEL=nomic-embed-text
QUALITY_REFERENCE_MODEL=

# Trust layer secrets. Generate both with: python scripts/generate_keys.py (never commit them).
VAULT_KEY=
RECEIPT_SIGNING_KEY=

# Router: keep a request local when any detection is below the low-confidence threshold.
ROUTE_LOW_CONFIDENCE_LOCAL=true
# Privacy-utility dial default until changed in the UI: max_privacy | balanced | max_quality
DEFAULT_DIAL=balanced

# Optional: when set, policy mutation endpoints require the X-Admin-Key header.
ADMIN_API_KEY=
